# Sans DATABASE_URL, le développement utilise un fichier local dans .data/.
# En production, PostgreSQL et SESSION_SECRET sont obligatoires.
# DATABASE_URL=postgresql://tower:tower@localhost:5432/tower?schema=public
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
# SESSION_SECRET=une-cle-aleatoire-de-plus-de-32-caracteres
# DEV_TOOLS=1
# 0–3 compagnons, retirés progressivement dès que 4 humains sont connectés.
BOT_COUNT=3
