# Sans DATABASE_URL, le développement utilise un fichier local dans .data/.
# En production, PostgreSQL et SESSION_SECRET sont obligatoires.
# DATABASE_URL=postgresql://tower:tower@localhost:5432/tower?schema=public
PORT=3001
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173
# SESSION_SECRET=une-cle-aleatoire-de-plus-de-32-caracteres
# DEV_TOOLS=1
# 0–3 compagnons ; 1 par défaut, présent même avec plusieurs humains.
BOT_COUNT=1
# auto : HTTP puis WebSocket si proposé ; polling : HTTP uniquement (N0C).
# Le lanceur app.cjs de N0C utilise polling par défaut.
# SOCKET_IO_TRANSPORT=auto
