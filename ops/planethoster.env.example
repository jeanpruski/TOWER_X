# Copier dans project/.env, à la racine du dépôt sur le serveur uniquement.
NODE_ENV=production
PUBLIC_ORIGIN=https://tower.example.com
# Reprendre l'hôte, le port, l'utilisateur et le nom COMPLET de la base dans N0C.
# Encoder les caractères spéciaux du mot de passe pour une URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
# Générer avec : openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BOT_COUNT=3
# Passenger prend en charge l'écoute réseau ; ne pas mettre PORT=passenger.
