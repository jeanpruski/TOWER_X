# Copier en .env sur le serveur de déploiement.
DOMAIN=tower.example.com
# Utiliser des chaînes hexadécimales aléatoires : elles sont sûres dans DATABASE_URL.
# Génération : openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-a-random-hex-password
SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
