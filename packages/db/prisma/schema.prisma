generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model User {
  id           String @id
  email        String @unique
  passwordHash String
  createdAt    DateTime @default(now())
  profile      PlayerProfile?
}
model PlayerProfile {
  id             String @id
  userId         String? @unique
  user           User? @relation(fields: [userId], references: [id])
  guestIdentity  String? @unique
  displayName    String
  cosmeticConfig Json
  settings       Json
  personalBest   Int @default(0)
  lastCampId     Int @default(0)
  createdAt      DateTime @default(now())
  camps          CampProgress[]
  sessions       Session[]
}
model CampProgress {
  profileId   String
  campId      Int
  activatedAt DateTime @default(now())
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([profileId, campId])
}
model Session {
  tokenHash String @id
  profileId String
  expiresAt DateTime
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model World {
  id               String @id
  worldSeed        Int
  worldVersion     Int @default(1)
  frontierMetadata Json
}
